# Telegram Bot Configuration
# Obtain your token by messaging @BotFather on Telegram (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: Webhook Secret Token for production Vercel deployment
TELEGRAM_SECRET_TOKEN=your_optional_webhook_secret

# NUS NextBus API Basic Authentication (Optional - falls back to realistic mock data if omitted)
NEXTBUS_USERNAME=
NEXTBUS_PASSWORD=

